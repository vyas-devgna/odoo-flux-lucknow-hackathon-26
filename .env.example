# Copy to .env and export, or set in your process manager. Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=billing.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://billing.example.com
DJANGO_DB=/var/lib/brightloop/db.sqlite3
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Brightloop <billing@example.com>
