# Copy to .env and export (or use your process manager's EnvironmentFile). Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=billing.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://billing.example.com
SITE_URL=https://billing.example.com           # used in emails and payment callbacks

# Database: SQLite file by default; PostgreSQL for production (pip install -r requirements-postgres.txt)
DJANGO_DB=/var/lib/brightloop/db.sqlite3
# DATABASE_URL=postgres://brightloop:password@db.internal:5432/brightloop

# Email (console backend is used when EMAIL_HOST is empty: it prints, it does not deliver)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Brightloop Studio <billing@example.com>
EMAIL_FQDN=example.com                          # Message-ID domain; avoids a slow reverse-DNS lookup

# Optional hosted checkout (Razorpay). Start with test keys; sandbox payments are excluded from revenue.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
